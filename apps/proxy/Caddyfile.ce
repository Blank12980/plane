{
    # TLS is terminated by the host nginx front-end (deployments/nginx/), which
    # gets its certificates from certbot. Caddy only does path routing over
    # plain HTTP on :80, bound to loopback — so automatic HTTPS is switched off
    # here. It would otherwise try (and fail) to bind :443 and run ACME
    # challenges that nginx already answers.
    auto_https off

    servers {
        max_header_size 25MB
        client_ip_headers X-Forwarded-For X-Real-IP
        trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
    }
}

# Zero-downtime rollouts (setup.sh): during a rollout the old and the new
# container of a service share one DNS name. If a connection to the container
# that is being retired breaks, keep trying for a few seconds instead of
# answering 502 - the next dial lands on the healthy container.
(retry_upstream) {
    lb_try_duration 8s
    lb_try_interval 250ms
}

(plane_proxy) {
    request_body {
        max_size {$FILE_SIZE_LIMIT}
    }
    
    redir /spaces /spaces/ permanent
    reverse_proxy /spaces/* space:3000 {
        import retry_upstream
    }
    
    redir /god-mode /god-mode/ permanent
    reverse_proxy /god-mode/* admin:3000 {
        import retry_upstream
    }
    
    reverse_proxy /live/* live:3000 {
        import retry_upstream
    }

    # MCP (Streamable HTTP): flush immediately so SSE responses are not buffered
    reverse_proxy /mcp* mcp:3000 {
        flush_interval -1
        import retry_upstream
    }
    reverse_proxy /api/* api:8000 {
        import retry_upstream
    }
    reverse_proxy /auth/* api:8000 {
        import retry_upstream
    }
    reverse_proxy /static/* api:8000 {
        import retry_upstream
    }
    
    reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
    reverse_proxy /{$BUCKET_NAME} plane-minio:9000
    
    reverse_proxy /* web:3000 {
        import retry_upstream
    }
}

{$SITE_ADDRESS} {
    import plane_proxy
}

# Optional add-on stacks (forgejo). The entrypoint drops snippet files into
# /etc/caddy/conf.d only when GIT_DOMAIN is set, so this import is a no-op when
# the feature is disabled.
#
# There is no mail snippet any more: it existed purely so Caddy would issue a
# Let's Encrypt certificate for mail.<domain>. certbot on the host owns that
# certificate now, and Postfix/Dovecot read it from /etc/letsencrypt.
import /etc/caddy/conf.d/*.caddy