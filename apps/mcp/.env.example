PORT=3000
# Internal URL of the Django API (no trailing slash, without /api/v1)
API_BASE_URL="http://api:8000"
# Public URL of the app, used to build links to work items in tool output
APP_BASE_URL="https://plane.example.com"
# Workspace used when a tool call does not pass workspace_slug (optional)
DEFAULT_WORKSPACE_SLUG=""
# Comma separated list of allowed browser origins. Requests without an Origin header
# (CLI / desktop MCP clients) are always allowed. APP_BASE_URL is allowed automatically.
MCP_ALLOWED_ORIGINS=""
# Timeout for calls to the API in milliseconds
API_TIMEOUT_MS=20000
