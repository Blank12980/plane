# ---------------------------------------------------------------------------
# Forgejo git hosting — https://git.${GIT_DOMAIN}
#
# Rendered by deployments/nginx/setup-nginx.sh into
# /etc/nginx/conf.d/20-git.conf, only when GIT_DOMAIN is set in the root .env.
#
# Traffic path: nginx -> Caddy (Host: git.${GIT_DOMAIN}) -> forgejo:3000 on the
# plane_default network. Git over SSH bypasses nginx entirely and hits the
# forgejo container directly on host port 2222.
#
# Template variables: ${GIT_DOMAIN}
# ---------------------------------------------------------------------------

server {
    listen      80;
    listen [::]:80;
    server_name git.${GIT_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root         /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen      443 ssl http2;
    listen [::]:443 ssl http2;
    server_name git.${GIT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/git.${GIT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/git.${GIT_DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/git.${GIT_DOMAIN}/chain.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/git.access.log;
    error_log  /var/log/nginx/git.error.log;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;

    # git push and LFS uploads have no useful size ceiling here; the Caddy git
    # site still caps the body at FILE_SIZE_LIMIT.
    client_max_body_size 0;

    location / {
        include /etc/nginx/conf.d/plane-proxy-params.inc;

        # git-upload-pack / git-receive-pack are streaming, chunked and slow.
        proxy_request_buffering off;
        proxy_buffering         off;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;

        proxy_pass http://plane_upstream;
    }
}
